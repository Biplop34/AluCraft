<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AluCraftSetup</AssemblyName>
    <RootNamespace>AluCraft.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\AluCraft.Windows\Assets\AluCraft.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload.zip" LogicalName="AluCraft.Setup.Payload.zip" />
  </ItemGroup>
</Project>
