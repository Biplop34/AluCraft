<Window x:Class="AluCraft.Windows.ScriptDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AluCraft"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="Assets/AluCraft.ico"
        KeyDown="Dialog_KeyDown">
  <Border Margin="14" Padding="24" Background="White" BorderBrush="#DDE5E8" BorderThickness="1" CornerRadius="20">
    <Border.Effect>
      <DropShadowEffect Color="#18212B" BlurRadius="28" ShadowDepth="8" Opacity="0.22" />
    </Border.Effect>
    <Grid Width="430">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="42" Height="42" Background="#E8F7F4" CornerRadius="13" Margin="0,0,12,0">
          <Image Source="Assets/AluCraft.ico" Width="30" Height="30" Stretch="Uniform" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="HeadingText" Text="AluCraft" FontSize="17" FontWeight="Bold" Foreground="#172033" />
          <TextBlock Text="AluCraft Desktop" FontSize="11" Foreground="#708090" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,18,0,0" FontSize="14" Foreground="#354253"
                 TextWrapping="Wrap" LineHeight="21" />
      <TextBox x:Name="ResponseInput" Grid.Row="2" Margin="0,16,0,0" MinHeight="44" Padding="12,10"
               FontSize="14" Foreground="#172033" Background="#F8FAFC" BorderBrush="#CBD5E1"
               BorderThickness="1" Visibility="Collapsed" />
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="CancelButton" Content="Cancel" MinWidth="100" Height="42" Margin="0,0,10,0"
                Padding="18,0" Background="White" Foreground="#435166" BorderBrush="#D5DEE5"
                BorderThickness="1" FontSize="13" FontWeight="SemiBold" Click="Cancel_Click" />
        <Button x:Name="AcceptButton" Content="Continue" MinWidth="112" Height="42" Padding="20,0"
                Background="#147D72" Foreground="White" BorderBrush="#147D72" BorderThickness="1"
                FontSize="13" FontWeight="Bold" IsDefault="True" Click="Accept_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
